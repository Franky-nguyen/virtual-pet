{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PosturePet 2.0",
  "version": "2.0.1",
  "identifier": "com.posturepet.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "PosturePet 2.0",
        "width": 380,
        "height": 620,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "center": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": {
      "../detector.py": "detector.py",
      "../pose_landmarker_heavy.task": "pose_landmarker_heavy.task",
      "../fixtures/mochi-cat-pack": "fixtures/mochi-cat-pack"
    }
  }
}
